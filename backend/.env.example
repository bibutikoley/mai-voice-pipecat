# ---------------------------------------------------------------------------
# Provider selection (STT and TTS are independent — any combination works)
# ---------------------------------------------------------------------------
# STT: mlx | moonshine | whisper | qwen | deepgram
#   mlx runs on the Mac (Apple Silicon) via `make audio-server`
STT_PROVIDER=mlx
# TTS: mlx | kokoro | piper | qwen | cartesia
TTS_PROVIDER=mlx

# LLM: stub (no key needed) | openai_compatible
LLM_MODE=stub

# Model memory: session (release at session end) | warm (release at server stop)
MODEL_LIFECYCLE=session

# ---------------------------------------------------------------------------
# LLM (required when LLM_MODE=openai_compatible)
# Works with OpenAI and any OpenAI-compatible endpoint.
# Examples:
#   Ollama Cloud:  LLM_BASE_URL=https://ollama.com/v1
#   Host Ollama:   LLM_BASE_URL=http://host.docker.internal:11434/v1
#   OpenAI:        LLM_BASE_URL=https://api.openai.com/v1
# ---------------------------------------------------------------------------
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ---------------------------------------------------------------------------
# Apple Silicon (MLX) host servers — run with `make audio-server`
# They bind to 127.0.0.1 only; the container reaches them via
# host.docker.internal, and the mobile apps cannot reach them at all.
# ---------------------------------------------------------------------------
MLX_AUDIO_BASE_URL=http://host.docker.internal:8000
MLX_STT_MODEL=mlx-community/Qwen3-ASR-0.6B-8bit
MLX_TTS_MODEL=mlx-community/Qwen3-TTS-12Hz-0.6B-CustomVoice-8bit
MLX_TTS_VOICE=Ryan

# ---------------------------------------------------------------------------
# Local STT options
# ---------------------------------------------------------------------------
MOONSHINE_MODEL=small-streaming
# WHISPER_MODEL=base.en

# Qwen ASR (Qwen/Qwen3-ASR-0.6B or Qwen/Qwen3-ASR-1.7B from the HF cache)
QWEN_ASR_MODEL=Qwen/Qwen3-ASR-0.6B
QWEN_ASR_LANGUAGE=English
QWEN_ASR_DEVICE=cpu

# ---------------------------------------------------------------------------
# Local TTS options
# ---------------------------------------------------------------------------
KOKORO_VOICE=af_heart
# PIPER_VOICE=en_US-ryan-high

# Output loudness applied after TTS (dB, -24..24; 0 = untouched). Local TTS is
# quiet, so the default raises it by 6 dB with clipping protection.
TTS_GAIN_DB=6.0

# Strip markdown/emoji before synthesis so the voice doesn't read symbols
# ("asterisk", "hashtag"). Options: markdown, emoji, none.
TTS_TEXT_FILTERS=markdown,emoji

# Qwen TTS (Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice or ...-1.7B-CustomVoice)
QWEN_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice
QWEN_TTS_SPEAKER=Ryan
QWEN_TTS_LANGUAGE=English
QWEN_TTS_DEVICE=cpu

# ---------------------------------------------------------------------------
# Cloud providers (optional; require an image built with EXTRAS=cloud)
# ---------------------------------------------------------------------------
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
