# ---------------------------------------------------------------------------
# Provider selection (STT and TTS are independent — any combination works)
# ---------------------------------------------------------------------------
# STT: moonshine | whisper | qwen | deepgram
STT_PROVIDER=moonshine
# TTS: kokoro | piper | qwen | cartesia
TTS_PROVIDER=kokoro

# LLM: stub (no key needed) | openai_compatible
LLM_MODE=stub

# Model memory: session (release at session end) | warm (release at server stop)
MODEL_LIFECYCLE=session

# ---------------------------------------------------------------------------
# LLM (required when LLM_MODE=openai_compatible)
# Works with OpenAI and any OpenAI-compatible endpoint (vLLM, LM Studio, Ollama,
# Groq, ...). From Docker, a server running on the host is reachable at
# http://host.docker.internal:<port>.
# ---------------------------------------------------------------------------
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ---------------------------------------------------------------------------
# Local STT options
# ---------------------------------------------------------------------------
MOONSHINE_MODEL=small-streaming
# WHISPER_MODEL=base.en

# Qwen ASR (Qwen/Qwen3-ASR-0.6B or Qwen/Qwen3-ASR-1.7B from the HF cache)
QWEN_ASR_MODEL=Qwen/Qwen3-ASR-0.6B
QWEN_ASR_LANGUAGE=English
QWEN_ASR_DEVICE=cpu

# ---------------------------------------------------------------------------
# Local TTS options
# ---------------------------------------------------------------------------
KOKORO_VOICE=af_heart
# PIPER_VOICE=en_US-ryan-high

# Qwen TTS (Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice or ...-1.7B-CustomVoice)
QWEN_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice
QWEN_TTS_SPEAKER=Ryan
QWEN_TTS_LANGUAGE=English
QWEN_TTS_DEVICE=cpu

# ---------------------------------------------------------------------------
# Cloud providers (optional; require an image built with EXTRAS=cloud)
# ---------------------------------------------------------------------------
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
